#!/bin/bash

function exec_hooks() {
    WCROOT=$(svn info | grep '^Working Copy Root Path: ' | cut -d : -f 1)
    HOOK=$WCROOT/.svnhooks/$1
    test -x $HOOK && $HOOK $@
}

COMMAND=$1

case $COMMAND in
    commit|ci)
        exec_hooks pre-commit $@
    ;;
    update|up)
        exec_hooks pre-update $@
    ;;
esac

/usr/bin/svn $*

case $COMMAND in
    checkout|co)
        exec_hooks post-checkout $@
    ;;
    commit|ci)
        exec_hooks post-commit $@
    ;;
    update|up)
        exec_hooks post-update $@
    ;;
esac
